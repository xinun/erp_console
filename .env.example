# ERP Console 환경변수 예시
#
# 사용 방법:
#   1. 이 파일을 `.env.local`로 복사합니다.
#   2. `.env.local`에 실제 값을 입력합니다.
#   3. 개발 서버를 다시 시작합니다.
#
# `.env.local`과 실제 Secret은 Git에 커밋하지 마세요.
# `NEXT_PUBLIC_` 접두사가 붙은 값은 브라우저 번들에 포함되므로
# 비밀번호, Client Secret, access token을 넣으면 안 됩니다.

# ── Atlassian (Jira / Confluence / JSM) ──────────────────────────────────────

# 공개 가능: Atlassian OAuth 2.0 (3LO) 앱의 Client ID
NEXT_PUBLIC_ATLASSIAN_CLIENT_ID=

# 비밀값: Atlassian OAuth 2.0 (3LO) 앱의 Client Secret
ATLASSIAN_CLIENT_SECRET=

# 브라우저 UI 기본값: 회사 계정으로 연결할 Jira Cloud 사이트
NEXT_PUBLIC_ATLASSIAN_JIRA_SITE_URL=

# 브라우저 UI 기본값: 별도 계정으로 연결할 Confluence Cloud 사이트
NEXT_PUBLIC_ATLASSIAN_CONFLUENCE_SITE_URL=

# ── Google Workspace ──────────────────────────────────────────────────────────

# 공개 가능: Google OAuth 웹 애플리케이션의 Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Mattermost ────────────────────────────────────────────────────────────────

# 서버 전용: Mattermost 기본 주소. 마지막 슬래시는 생략합니다.
MATTERMOST_BASE_URL=https://mattermost.example.com

# 서버 전용: Mattermost OAuth 앱의 Client ID
MATTERMOST_CLIENT_ID=

# 비밀값: Mattermost OAuth 앱의 Client Secret
MATTERMOST_CLIENT_SECRET=

# 브라우저 UI 기본값: 위 MATTERMOST_BASE_URL과 같은 주소
NEXT_PUBLIC_MATTERMOST_URL=https://mattermost.example.com

# 브라우저 UI 기본값: 위 MATTERMOST_CLIENT_ID와 같은 Client ID
NEXT_PUBLIC_MATTERMOST_CLIENT_ID=
